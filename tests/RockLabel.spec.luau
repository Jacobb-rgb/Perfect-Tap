-- The name + HP label over mine rocks (client UI builder) and the pure rules the label manager uses.
return function(T, Loader)
	local Theme = Loader.requirePath("ReplicatedStorage.Shared.Config.UITheme")
	local MineFloors = Loader.requirePath("ReplicatedStorage.Shared.Config.MineFloors")
	local RockLabel = Loader.requirePath("StarterPlayer.StarterPlayerScripts.Client.UI.RockLabel")

	T.test("RockLabel: name, HP and a full bar, culled a bit past 45 studs, hidden behind walls", function()
		local hp = MineFloors.rockHealth(1, "Small")
		local refs = RockLabel.build(MineFloors.rockName(1, "Small"), MineFloors.labelColor(1, "Small"), hp, 4)
		T.eq(refs.Name.Text, "Greystone", "name")
		T.eq(refs.Hp.Text, hp .. " HP", "hp text")
		T.eq(refs.Fill.Size.X.Scale, 1, "full bar")
		T.eq(RockLabel.MaxDistance, 45, "pick range")
		T.eq(refs.Gui.MaxDistance, RockLabel.MaxDistance + RockLabel.CameraSlack, "engine cull: the camera sits behind the player")
		T.eq(refs.Gui.AlwaysOnTop, false, "not through walls")
		T.near(refs.Gui.StudsOffsetWorldSpace.Y, 4 + RockLabel.Gap, 1e-3, "above the rock")
		T.eq(refs.Note.Visible, false, "no note by default")
	end)

	T.test("RockLabel: set shows damage, clamps, Lv N for locked and VIP for VIP rocks", function()
		local refs = RockLabel.build("Basalt", MineFloors.labelColor(2, "Small"), 80, 4)
		RockLabel.set(refs, 20, 80)
		T.eq(refs.Hp.Text, "20 HP", "hp after damage")
		T.near(refs.Fill.Size.X.Scale, 0.25, 1e-6, "quarter bar")
		RockLabel.set(refs, -5, 80)
		T.eq(refs.Hp.Text, "0 HP", "never negative")
		RockLabel.set(refs, 80, 80, 5)
		T.eq(refs.Hp.Text, "Lv 5", "locked")
		T.eq(refs.Hp.TextColor3, Theme.Bad, "locked in red")
		RockLabel.set(refs, 80, 80, nil, true)
		T.eq(refs.Hp.Text, "VIP", "vip rock")
		T.eq(refs.Hp.TextColor3, Theme.Coin, "vip in gold")
		RockLabel.set(refs, 12345, 20000)
		T.eq(refs.Hp.Text, "12.3K HP", "big numbers shortened")
		T.eq(refs.Hp.TextColor3, Theme.Text, "unlocked again")
	end)

	T.test("RockLabel: names and colors for every floor and kind, Grotto rocks without a floor", function()
		for _, floor in MineFloors.List do
			for _, kind in { "Small", "Big", "Crystal", "Golden", "Geode", "Artifact", "Giant" } do
				local name = MineFloors.rockName(floor.Index, kind)
				T.truthy(#name > 0 and #name <= 22, floor.Id .. " " .. kind .. " name fits: " .. name)
				T.truthy(MineFloors.labelColor(floor.Index, kind) ~= nil, floor.Id .. " " .. kind .. " color")
				local infoName, infoColor = RockLabel.rockInfo(floor.Index, kind)
				T.eq(infoName, name, "rockInfo name " .. kind)
				T.eq(infoColor, MineFloors.labelColor(floor.Index, kind), "rockInfo color " .. kind)
			end
		end
		T.eq(MineFloors.rockName(2, "Big"), "Basalt Boulder", "big rock name")
		T.eq(MineFloors.rockName(3, "Crystal"), "Azure Shard", "crystal name")
		local grotto, color = RockLabel.rockInfo(nil, nil)
		T.eq(grotto, "Grotto Rock", "rocks without a floor are Grotto rocks")
		T.eq(color, MineFloors.LabelColors.Rock, "warm white")
		T.eq((RockLabel.rockInfo(1, "Weird")), "Greystone", "unknown kinds are Small")
		T.eq((RockLabel.rockInfo(42, "Big")), "Grotto Rock", "unknown floors are Grotto rocks")
	end)

	T.test("RockLabel: lock rules (blaster level vs MinBlaster, VIP perk)", function()
		local needed, vip = RockLabel.lockOf(1, 3, false, false)
		T.eq(needed, 3, "level 1 on a floor-2 rock needs Lv 3")
		T.eq(vip, false, "not vip")
		needed = RockLabel.lockOf(3, 3, nil, false)
		T.eq(needed, nil, "equal level is enough")
		needed = RockLabel.lockOf(9, 5, nil, false)
		T.eq(needed, nil, "stronger blaster")
		needed = RockLabel.lockOf(1, nil, nil, false)
		T.eq(needed, nil, "rocks without MinBlaster are open")
		local _, vipLocked = RockLabel.lockOf(10, 1, true, false)
		T.eq(vipLocked, true, "vip rock without the perk")
		local _, vipOpen = RockLabel.lockOf(10, 1, true, true)
		T.eq(vipOpen, false, "vip rock with the perk")
		T.eq(RockLabel.hpText(19.2, 20), "20 HP", "partial HP rounds up (the rock is not empty yet)")
		T.eq(RockLabel.hpText(0, 0), "0 HP", "zero max is safe")
	end)

	T.test("RockLabel: pick takes the nearest rocks in range, front first, at most the cap", function()
		local list = {}
		for i = 1, 30 do
			table.insert(list, { Rock = "r" .. i, Distance = (31 - i) * 2, Behind = false })
		end
		table.insert(list, { Rock = "far", Distance = 46 })
		table.insert(list, { Rock = "behind", Distance = 1, Behind = true })
		local picked = RockLabel.pick(list, 12)
		T.eq(#picked, 12, "cap")
		T.eq(picked[1].Rock, "r30", "nearest first")
		for i = 2, #picked do
			T.le(picked[i - 1].Distance, picked[i].Distance, "sorted by distance")
		end
		for _, c in picked do
			T.truthy(c.Rock ~= "far", "out of range")
			T.truthy(c.Rock ~= "behind", "a rock behind the camera loses to rocks in front")
		end
		local few = RockLabel.pick({ { Rock = "a", Distance = 10 }, { Rock = "b", Distance = 3, Behind = true } }, 12)
		T.eq(#few, 2, "behind rocks still get a label when there is room")
		T.eq(few[1].Rock, "a", "front rock first")
		T.eq(#RockLabel.pick({}, 12), 0, "no rocks")
		T.eq(#RockLabel.pick(list), RockLabel.MaxLabels, "default cap")
	end)

	T.test("RockLabel: far labels shrink and fade, phones get fewer and smaller labels", function()
		local s0, f0 = RockLabel.fade(5)
		T.eq(s0, 1, "near: full size")
		T.eq(f0, 0, "near: opaque")
		local lastScale, lastFade = 1, 0
		for d = 10, 60, 5 do
			local s, f = RockLabel.fade(d)
			T.le(s, lastScale, "shrinks with distance")
			T.le(lastFade, f, "fades with distance")
			T.truthy(s >= 0.6 and f <= 0.35, "still readable at " .. d)
			lastScale, lastFade = s, f
		end
		T.eq(RockLabel.maxLabels(390), RockLabel.PhoneLabels, "phone")
		T.eq(RockLabel.maxLabels(1080), 12, "TV / PC")
		T.lt(RockLabel.screenScale(390), RockLabel.screenScale(1080), "phone labels are smaller")
		T.truthy(20 * RockLabel.screenScale(1080) >= 18, "name text >= 18 px on a 1080p TV")
		T.truthy(RockLabel.screenScale(390) >= 0.6, "phone floor")
	end)

	T.test("RockLabel: declutter hides labels that would cover a nearer one, without flicker", function()
		local a = RockLabel.rect("near", 500, 300, 1)
		local b = RockLabel.rect("behind", 520, 305, 0.8) -- right on top of the near label
		local c = RockLabel.rect("free", 900, 300, 0.8) -- far to the side
		local shown = RockLabel.declutter({ a, b, c })
		T.eq(shown.near, true, "priority label always shows")
		T.eq(shown.behind, nil, "covered label hides")
		T.eq(shown.free, true, "free label shows")
		-- a touch of overlap: a shown label stays, a hidden one waits for more room
		local edge = a.X + a.W / 2 + RockLabel.rect("x", 0, 0, 1).W * 0.48
		local touching = RockLabel.declutter({ a, RockLabel.rect("edge", edge, 300, 1, true) })
		T.eq(touching.edge, true, "a shown label keeps showing at a small overlap")
		local waiting = RockLabel.declutter({ a, RockLabel.rect("edge", edge, 300, 1, false) })
		T.eq(waiting.edge, nil, "a hidden label comes back only with room to spare")
		local bigger = RockLabel.rect("k", 0, 0, 1.12)
		local smaller = RockLabel.rect("k", 0, 0, 0.62)
		T.lt(smaller.W, bigger.W, "rect scales with the label")
		T.lt(bigger.Y, 0, "the name and bar sit above the anchor")
	end)

	T.test("RockLabel: retarget, note and look on a pooled label", function()
		local refs = RockLabel.build("Greystone", MineFloors.labelColor(1, "Small"), 20, 4)
		RockLabel.setNote(refs, "Needs Lv 3")
		T.eq(refs.Note.Visible, true, "note shown")
		T.eq(refs.Note.Text, "Needs Lv 3", "note text")
		RockLabel.retarget(refs, "Ember Shard", MineFloors.labelColor(2, "Crystal"), 6)
		T.eq(refs.Name.Text, "Ember Shard", "new name")
		T.eq(refs.Note.Visible, false, "note cleared on retarget")
		T.near(refs.Gui.StudsOffsetWorldSpace.Y, 6 + RockLabel.Gap, 1e-3, "new height")
		RockLabel.set(refs, 30, 30)
		T.eq(refs.Hp.Text, "30 HP", "hp after retarget")
		RockLabel.setLook(refs, 0.8, 0.3)
		T.near(refs.Scale.Scale, 0.8, 1e-6, "scale")
		T.near(refs.Name.TextTransparency, 0.3, 1e-6, "faded name")
		T.near(refs.Fill.BackgroundTransparency, 0.3, 1e-6, "faded bar")
	end)
end
