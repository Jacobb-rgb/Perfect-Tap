--[[
	World layout of Terra (studs). Ground level is Y = 0.

	        N (-Z)
	   Deep Hollow   (y -40)
	   Ember Caves   (y -12)        Glimmer Grotto (VIP, east)
	   Greystone Quarry (pit, y -12)
	   Great Forge
	W  [plots] ---- Emberfall plaza ---- [plots]  E
	   Spawn
	        S (+Z)

	The map itself is generated by src/server/World/WorldBuilder from this
	table. Zones are boxes: when a player is inside one, the client switches
	lighting preset and the server uses the zone's ore weights for node spawns.
]]

export type Zone = {
	Id: string,
	Name: string,
	Min: Vector3, -- box corner (inclusive)
	Max: Vector3,
	Lighting: string, -- LightingConfig preset
	FloorY: number,
	Ores: { [string]: number }, -- ore weights for the ores inside rocks in this zone
	NodeCount: number, -- rocks in this zone
	MinBlaster: number, -- blaster level needed to damage rocks here
	RockHealth: number, -- base HP of a rock here (BlasterData.rockHealth scales it)
	VipOnly: boolean?,
	Priority: number, -- higher wins when boxes overlap
}

export type Plot = {
	Id: number,
	Center: Vector3, -- center of the pad's top surface
	Facing: Vector3, -- the side of the plot that faces the road
}

