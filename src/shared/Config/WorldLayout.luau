function WorldLayout.isInBox(position: Vector3, min: Vector3, max: Vector3): boolean
	return position.X >= min.X
		and position.X <= max.X
		and position.Y >= min.Y
		and position.Y <= max.Y
		and position.Z >= min.Z
		and position.Z <= max.Z
end

-- Highest-priority zone containing the position (nil outside the world).
function WorldLayout.zoneAt(position: Vector3): Zone?
	local best: Zone? = nil
	for _, zone in WorldLayout.Zones do
		if zone.Priority >= 0 and WorldLayout.isInBox(position, zone.Min, zone.Max) then
			if not best or zone.Priority > best.Priority then
				best = zone
			end
		end
	end
	return best
end

function WorldLayout.isKeepOut(position: Vector3, margin: number?): boolean
	local m = margin or 0
	local pad = Vector3.new(m, 0, m)
	for _, box in WorldLayout.KeepOut do
		if WorldLayout.isInBox(position, box.Min - pad, box.Max + pad) then
			return true
		end
	end
	return false
end

-- The CFrame of a plot: origin at pad top center, LookVector = Facing (road side).
function WorldLayout.plotCFrame(plot: Plot): CFrame
	return CFrame.lookAt(plot.Center, plot.Center + plot.Facing)
end

return WorldLayout
